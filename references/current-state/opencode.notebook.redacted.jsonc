{
    "$schema": "https://opencode.ai/config.json",
    "provider": {
        "9router": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "9Router Homelab",
            "options": {
                "baseURL": "{env:BASE_URL_9ROUTER}",
                "apiKey": "{file:~/.local/share/opencode/secrets/9router-api-key}"
            },
            "models": {
                "combo-main": {
                    "name": "combo-main",
                    "variants": {
                        "high": {
                            "reasoningEffort": "high",
                            "textVerbosity": "low",
                            "reasoningSummary": "auto"
                        },
                        "low": {
                            "reasoningEffort": "low",
                            "textVerbosity": "low",
                            "reasoningSummary": "auto"
                        }
                    },
                    "modalities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    }
                },
                "combo-cheap": {
                    "name": "combo-cheap",
                    "options": {
                        "thinking": {
                            "type": "enabled",
                            "budgetTokens": 16000
                        },
                        "modalities": {
                            "input": [
                                "text",
                                "image"
                            ],
                            "output": [
                                "text"
                            ]
                        }
                    }
                }
            }
        }
    },
    "default_agent": "build",
    "formatter": true,
    "lsp": true,
    "mcp": {
        "homelab-ai-coding": {
            "type": "remote",
            "url": "http://homelab.local:8811/mcp"
        }
    },
    "instructions": [
        "~/.config/opencode/AGENTS.md",
        "./AGENTS.md"
    ],
    "permission": {
        "task": {
            "*": "allow"
        },
        "skill": {
            "*": "allow"
        }
    },
    "agent": {
        "build": {
            "mode": "primary",
            "model": "9router/combo-main",
            "prompt": "~/.config/opencode/prompts/build.txt",
            "tools": {
                "write": true,
                "edit": true,
                "bash": true
            }
        },
        "plan": {
            "mode": "primary",
            "model": "9router/combo-cheap",
            "prompt": "~/.config/opencode/prompts/plan.txt",
            "tools": {
                "write": false,
                "edit": false,
                "bash": false
            }
        }
    }
}