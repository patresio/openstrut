{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "snapshot": true,
  "autoupdate": "notify",
  "compaction": {
    "auto": true
  },
  "model": "{env:MODEL_TECH}",
  "small_model": "{env:MODEL_LIGHT}",
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9Router Homelab",
      "options": {
        "baseURL": "{env:NINE_ROUTER_BASE_URL}",
        "apiKey": "{env:NINE_ROUTER_API_KEY}"
      },
      "models": {
        "combo-main": {
          "name": "9Router Combo Main",
          "variants": {
            "high": {
              "reasoningEffort": "high",
              "textVerbosity": "low"
            },
            "low": {
              "reasoningEffort": "low",
              "textVerbosity": "low"
            }
          }
        },
        "combo-cheap": {
          "name": "9Router Combo Cheap"
        },
        "combo-lead": {
          "name": "9Router Combo Lead"
        },
        "combo-tech": {
          "name": "9Router Combo Tech"
        },
        "combo-light": {
          "name": "9Router Combo Light"
        },
        "combo-prefeitura-lead": {
          "name": "9Router Combo Prefeitura Lead"
        },
        "combo-prefeitura-tech": {
          "name": "9Router Combo Prefeitura Tech"
        },
        "combo-prefeitura-light": {
          "name": "9Router Combo Prefeitura Light"
        }
      }
    }
  },
  "mcp": {
    "homelab-ai-coding": {
      "type": "remote",
      "url": "{env:HOMELAB_AI_CODING_MCP_URL}"
    },
    "barsa": {
      "type": "remote",
      "url": "{env:BARSA_MCP_URL}",
      "enabled": true
    }
  },
  "default_agent": "trust-lead",
  "instructions": [
    "opentrust/docs/TEAM_TOPOLOGY.md",
    "opentrust/docs/WORKFLOW.md",
    "opentrust/docs/TASK_CONTRACT.md",
    "opentrust/docs/PERMISSIONS.md",
    "opentrust/docs/OBSERVABILITY.md",
    "opentrust/docs/OPERATIONAL_RETRIEVAL_MAP.md",
    "opentrust/docs/REFERENCE_PROFILES.md"
  ],
  "references": {
    "reference-map": {
      "path": "opentrust/reference-map",
      "description": "OpenTrust Reference Library \u2014 selector definitions and team-context matrix for the Operational Retrieval Map"
    },
    "docs-opencode": {
      "path": "opentrust/docs",
      "description": "OpenTrust foundation documentation \u2014 team topology, workflow, contracts, permissions, retrieval architecture"
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".git/**",
      ".venv/**",
      "__pycache__/**",
      ".pytest_cache/**",
      ".mypy_cache/**",
      ".ruff_cache/**"
    ]
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "question": "allow",
    "external_directory": "ask",
    "doom_loop": "ask",
    "skill": "ask"
  },
  "agent": {
    "trust-lead": { "model": "{env:MODEL_LEAD}" },
    "product-lead": { "model": "{env:MODEL_LEAD}" },
    "architecture-lead": { "model": "{env:MODEL_LEAD}" },
    "engineering-lead": { "model": "{env:MODEL_LEAD}" },
    "quality-lead": { "model": "{env:MODEL_LEAD}" },
    "review-lead": { "model": "{env:MODEL_LEAD}" },
    "devops-lead": { "model": "{env:MODEL_LEAD}" },
    "delivery-lead": { "model": "{env:MODEL_LEAD}" },
    "knowledge-lead": { "model": "{env:MODEL_LEAD}" },
    "architecture-decision-designer": { "model": "{env:MODEL_LEAD}" },
    "domain-modeler": { "model": "{env:MODEL_LEAD}" },
    "api-database-designer": { "model": "{env:MODEL_LEAD}" },
    "distributed-systems-reviewer": { "model": "{env:MODEL_LEAD}" },
    "issue-pr-coordinator": { "model": "{env:MODEL_LEAD}" },

    "feature-implementer": { "model": "{env:MODEL_TECH}" },
    "tdd-engineer": { "model": "{env:MODEL_TECH}" },
    "code-refactoring-specialist": { "model": "{env:MODEL_TECH}" },
    "performance-engineer": { "model": "{env:MODEL_TECH}" },
    "security-reviewer": { "model": "{env:MODEL_TECH}" },
    "privacy-reviewer": { "model": "{env:MODEL_TECH}" },
    "integration-tester": { "model": "{env:MODEL_TECH}" },
    "testing-strategy-designer": { "model": "{env:MODEL_TECH}" },
    "code-reviewer": { "model": "{env:MODEL_TECH}" },
    "compliance-auditor": { "model": "{env:MODEL_TECH}" },
    "ux-accessibility-reviewer": { "model": "{env:MODEL_TECH}" },
    "ci-cd-infrastructure-engineer": { "model": "{env:MODEL_TECH}" },
    "observability-designer": { "model": "{env:MODEL_TECH}" },
    "incident-triage-specialist": { "model": "{env:MODEL_TECH}" },
    "workflow-governance-auditor": { "model": "{env:MODEL_TECH}" },

    "coordination-facilitator": { "model": "{env:MODEL_LIGHT}" },
    "meeting-scribe": { "model": "{env:MODEL_LIGHT}" },
    "decision-logger": { "model": "{env:MODEL_LIGHT}" },
    "context-historian": { "model": "{env:MODEL_LIGHT}" },
    "reference-librarian": { "model": "{env:MODEL_LIGHT}" },
    "documentation-skill-creator": { "model": "{env:MODEL_LIGHT}" },
    "product-discovery": { "model": "{env:MODEL_LIGHT}" },
    "requirements-analyzer": { "model": "{env:MODEL_LIGHT}" },
    "story-slicer": { "model": "{env:MODEL_LIGHT}" },
    "release-manager": { "model": "{env:MODEL_LIGHT}" },
    "changelog-writer": { "model": "{env:MODEL_LIGHT}" }
  }
}
