{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "snapshot": true,
  "autoupdate": "notify",
  "compaction": {
    "auto": true
  },
  "model": "9router/combo-main",
  "small_model": "9router/combo-cheap",
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9Router Homelab",
      "options": {
        "baseURL": "{env:BASE_URL_9ROUTER}",
        "apiKey": "{file:~/.local/share/opencode/secrets/9router-api-key}"
      },
      "models": {
        "combo-main": {
          "name": "combo-main",
          "variants": {
            "high": {
              "reasoningEffort": "high",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            },
            "low": {
              "reasoningEffort": "low",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            }
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "combo-cheap": {
          "name": "combo-cheap",
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 16000
            }
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "mcp": {
    "homelab-ai-coding": {
      "type": "remote",
      "url": "{env:HOMELAB_AI_CODING_MCP_URL}"
    },
    "barsa": {
      "type": "remote",
      "url": "{env:BARSA_MCP}",
      "enabled": true
    }
  },
  "default_agent": "trust-lead",
  "instructions": [
    "opentrust/docs/TEAM_TOPOLOGY.md",
    "opentrust/docs/WORKFLOW.md",
    "opentrust/docs/TASK_CONTRACT.md",
    "opentrust/docs/PERMISSIONS.md",
    "opentrust/docs/OBSERVABILITY.md",
    "opentrust/docs/OPERATIONAL_RETRIEVAL_MAP.md",
    "opentrust/docs/REFERENCE_PROFILES.md"
  ],
  "references": {
    "reference-map": {
      "path": "opentrust/reference-map",
      "description": "OpenTrust Reference Library \u2014 selector definitions and team-context matrix for the Operational Retrieval Map"
    },
    "docs-opencode": {
      "path": "opentrust/docs",
      "description": "OpenTrust foundation documentation \u2014 team topology, workflow, contracts, permissions, retrieval architecture"
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".git/**",
      ".venv/**",
      "__pycache__/**",
      ".pytest_cache/**",
      ".mypy_cache/**",
      ".ruff_cache/**"
    ]
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "question": "allow",
    "external_directory": "ask",
    "doom_loop": "ask",
    "skill": "ask"
  }
}
