      "permission": {
        "read": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    },
    "api-database-designer": {
      "description": "Designs API contracts, database schemas, migrations, and integration patterns",
      "mode": "subagent",
      "model": "9router/combo-cheap",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    },
    "distributed-systems-reviewer": {
      "description": "Reviews consistency, concurrency, failure modes, and recovery patterns",
      "mode": "subagent",
      "model": "9router/combo-cheap",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    },
    "feature-implementer": {
      "description": "Implements new features following existing patterns and architecture",
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "allow",
        "task": "deny"
      }
    },
    "code-refactoring-specialist": {
      "description": "Refactors code incrementally with behavior preservation",
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": {
          "npm test*": "allow",
          "git status*": "allow",
          "git diff*": "allow"
        },
        "task": "deny"
      }
    },
    "performance-engineer": {
      "description": "Analyzes, profiles, and optimizes system performance",
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "edit": {
          "src/**": "allow",
          "tests/**": "allow"
        },
        "bash": "allow",
        "task": "deny"
      }
    },
    "security-reviewer": {
      "description": "Reviews code for security vulnerabilities and threats",
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "bash": {
          "git status*": "allow",
