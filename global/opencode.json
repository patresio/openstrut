{
    "$schema": "https://opencode.ai/config.json",
    "default_agent": "build",
    "share": "disabled",
    "snapshot": true,
    "autoupdate": "notify",
    "compaction": {
        "auto": true
    },
    "model": "9router/combo-main",
    "small_model": "9router/combo-cheap",
    "provider": {
        "9router": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "9Router Homelab",
            "options": {
                "baseURL": "{env:BASE_URL_9ROUTER}",
                "apiKey": "{file:~/.local/share/opencode/secrets/9router-api-key}"
            },
            "models": {
                "combo-main": {
                    "name": "combo-main",
                    "variants": {
                        "high": {
                            "reasoningEffort": "high",
                            "textVerbosity": "low",
                            "reasoningSummary": "auto"
                        },
                        "low": {
                            "reasoningEffort": "low",
                            "textVerbosity": "low",
                            "reasoningSummary": "auto"
                        }
                    },
                    "modalities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    }
                },
                "combo-cheap": {
                    "name": "combo-cheap",
                    "options": {
                        "thinking": {
                            "type": "enabled",
                            "budgetTokens": 16000
                        }
                    },
                    "modalities": {
                        "input": [
                            "text",
                            "image"
                        ],
                        "output": [
                            "text"
                        ]
                    }
                }
            }
        }
    },
    "mcp": {
        "homelab-ai-coding": {
            "type": "remote",
            "url": "{env:HOMELAB_AI_CODING_MCP_URL}"
        },
        "barsa": {
            "type": "remote",
            "url": "{env:BARSA_MCP}",
            "enabled": true
        }
    },
    "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "question": "allow",
        "external_directory": "ask",
        "skill": "deny",
        "task": "deny",
        "bash": "ask",
        "edit": "ask"
    },
    "agent": {
        "build": {
            "mode": "primary",
            "model": "9router/combo-main",
            "permission": {
                "edit": "allow",
                "skill": {
                    "*": "deny",
                    "engineering-*": "allow",
                    "harness-generation": "allow",
                    "worktree-lifecycle-management": "allow",
                    "knowledge-system-design": "allow",
                    "learning-plan-design": "allow",
                    "personal-execution-system": "allow",
                    "financial-organization": "allow",
                    "product-discovery": "allow",
                    "leadership-feedback": "allow",
                    "career-positioning": "allow",
                    "architecture-decision": "allow",
                    "domain-modeling": "allow",
                    "distributed-systems-review": "allow",
                    "api-data-design": "allow",
                    "devops-sre-diagnostics": "allow",
                    "frontend-ux-review": "allow",
                    "code-refactoring": "allow",
                    "security-review": "allow",
                    "testing-strategy": "allow",
                    "rag-agent-design": "allow",
                    "health-planning": "allow",
                    "performance-engineering": "allow",
                    "release-management": "allow",
                    "compliance-audit": "allow",
                    "database-design": "allow",
                    "observability-design": "allow",
                    "accessibility-review": "allow",
                    "localization": "allow",
                    "privacy-review": "allow"
                },
                "task": {
                    "*": "deny",
                    "explore": "allow",
                    "scout": "allow",
                    "code-reviewer": "allow",
                    "project-rules-auditor": "allow",
                    "documentation-generator": "allow",
                    "harness-generator": "allow",
                    "skill-creator": "allow",
                    "performance-optimizer": "allow",
                    "release-manager": "allow",
                    "compliance-auditor": "allow",
                    "knowledge-system-designer": "allow",
                    "personal-operating-system-advisor": "allow",
                    "business-product-strategist": "allow",
                    "career-communication-advisor": "allow",
                    "software-architect": "allow",
                    "backend-data-reviewer": "allow",
                    "devops-sre-advisor": "allow",
                    "code-quality-testing-reviewer": "allow",
                    "security-infrastructure-reviewer": "allow",
                    "frontend-ux-reviewer": "allow",
                    "ai-rag-agent-architect": "allow",
                    "health-exercise-nutrition-researcher": "allow",
                    "sdd": "allow"
                }
            }
        },
        "plan": {
            "mode": "primary",
            "model": "opencode/deepseek-v4-flash-free",
            "permission": {
                "edit": "deny",
                "bash": {
                    "*": "deny",
                    "git status*": "allow",
                    "git diff*": "allow",
                    "git log*": "allow",
                    "git show*": "allow",
                    "git branch --show-current": "allow",
                    "git remote -v": "allow",
                    "git worktree list*": "allow"
                },
                "task": {
                    "*": "deny",
                    "explore": "allow",
                    "scout": "allow",
                    "skill-creator": "allow"
                }
            }
        },
        "explore": {
            "model": "opencode/mimo-v2.5-free",
            "permission": {
                "edit": "deny",
                "task": "deny",
                "external_directory": "deny",
                "bash": {
                    "*": "deny",
                    "git status*": "allow",
