{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "snapshot": true,
  "autoupdate": "notify",
  "compaction": {
    "auto": true
  },
  "model": "9router/combo-main",
  "small_model": "9router/combo-cheap",
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9Router Homelab",
      "options": {
        "baseURL": "{env:BASE_URL_9ROUTER}",
        "apiKey": "{file:~/.local/share/opencode/secrets/9router-api-key}"
      },
      "models": {
        "combo-main": {
          "name": "combo-main",
          "variants": {
            "high": {
              "reasoningEffort": "high",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            },
            "low": {
              "reasoningEffort": "low",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            }
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "combo-cheap": {
          "name": "combo-cheap",
          "options": {
            "thinking": {
              "type": "enabled",
              "budgetTokens": 16000
            }
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    },
    "opencode": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Zen",
      "options": {
        "baseURL": "{env:OPENCODE_ZEN_URL}",
        "apiKey": "{file:~/.local/share/opencode/secrets/opencode-zen-api-key}"
      },
      "models": {
        "big-pickle": {
          "name": "Big Pickle"
        },
        "deepseek-v4-flash-free": {
          "name": "DeepSeek V4 Flash Free"
        },
        "mimo-v2.5-free": {
          "name": "MiMo V2.5 Free"
        }
      }
    }
  },
  "mcp": {
    "homelab-ai-coding": {
      "type": "remote",
      "url": "{env:HOMELAB_AI_CODING_MCP_URL}"
    },
    "barsa": {
      "type": "remote",
      "url": "{env:BARSA_MCP}",
      "enabled": true
    }
  },
  "default_agent": "trust-lead",
  "instructions": [
    "opentrust/docs/TEAM_TOPOLOGY.md",
    "opentrust/docs/WORKFLOW.md",
    "opentrust/docs/TASK_CONTRACT.md",
    "opentrust/docs/PERMISSIONS.md",
    "opentrust/docs/OBSERVABILITY.md",
    "opentrust/docs/OPERATIONAL_RETRIEVAL_MAP.md",
    "opentrust/docs/REFERENCE_PROFILES.md"
  ],
  "references": {
    "reference-map": {
      "path": "opentrust/reference-map",
      "description": "OpenTrust Reference Library \u2014 selector definitions and team-context matrix for the Operational Retrieval Map"
    },
    "docs-opencode": {
      "path": "opentrust/docs",
      "description": "OpenTrust foundation documentation \u2014 team topology, workflow, contracts, permissions, retrieval architecture"
    }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      ".git/**",
      ".venv/**",
      "__pycache__/**",
      ".pytest_cache/**",
      ".mypy_cache/**",
      ".ruff_cache/**"
    ]
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "question": "allow",
    "external_directory": "ask",
    "doom_loop": "ask",
    "skill": "ask"
  },
  "agent": {
    "build": {
      "description": "General-purpose implementation agent for approved changes",
      "mode": "primary",
      "model": "opencode/big-pickle",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "allow",
        "task": "deny"
      }
    },
    "trust-lead": {
      "description": "Coordinates cross-team communication, decision logging, meeting facilitation, and overall process health",
      "mode": "primary",
      "model": "opencode/big-pickle",
      "permission": {
        "read": "allow",
        "edit": {
          ".opencode/**": "allow"
        },
        "bash": {
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git branch --show-current": "allow"
        },
        "task": "allow"
      }
    },
    "product-lead": {
      "description": "Product strategy, discovery, requirements, acceptance criteria, and story slicing",
      "mode": "primary",
      "model": "opencode/big-pickle",
      "permission": {
        "read": "allow",
        "edit": {
          "docs/opencode/**": "allow"
        },
        "bash": {
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow"
        },
        "task": "allow"
      }
    },
    "architecture-lead": {
      "description": "Structural decisions, domain modeling, API contracts, database schemas, distributed systems, and ADRs",
      "mode": "primary",
      "model": "opencode/big-pickle",
      "permission": {
        "read": "allow",
        "edit": {
          "docs/opencode/**": "allow",
          "docs/decisions/**": "allow"
        },
        "bash": {
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow"
        },
        "task": "allow"
      }
    },
    "engineering-lead": {
      "description": "Implementation, refactoring, performance, security, and privacy \u2014 primary implementation team lead",
      "mode": "primary",
      "model": "opencode/big-pickle",
      "permission": {
        "read": "allow",
        "edit": {
          "src/**": "allow",
          "tests/**": "allow"
        },
        "bash": {
          "npm test*": "allow",
          "node --test*": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow"
        },
        "task": "allow"
      }
    },
    "quality-lead": {
      "description": "Test strategy, TDD, integration tests, end-to-end tests, and quality gates",
      "mode": "primary",
      "model": "opencode/big-pickle",
      "permission": {
        "read": "allow",
        "edit": {
          "tests/**": "allow"
        },
        "bash": "allow",
        "task": "allow"
      }
    },
    "review-lead": {
      "description": "Independent review, compliance, frontend/UX review, and accessibility \u2014 gating function before delivery",
      "mode": "primary",
      "model": "opencode/big-pickle",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "bash": {
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git branch --show-current": "allow"
        },
        "task": "allow"
      }
    },
    "devops-lead": {
      "description": "CI/CD, infrastructure, observability, and incident response",
      "mode": "primary",
      "model": "opencode/big-pickle",
      "permission": {
        "read": "allow",
        "edit": {
          ".github/**": "allow",
          "scripts/**": "allow",
          ".opencode/**": "allow"
        },
        "bash": "allow",
        "task": "allow"
      }
    },
    "delivery-lead": {
      "description": "Release management, versioning, changelog, and deployment coordination",
      "mode": "primary",
      "model": "opencode/big-pickle",
      "permission": {
        "read": "allow",
        "edit": {
          "docs/**": "allow",
          ".opencode/**": "allow"
        },
        "bash": {
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git branch --show-current": "allow",
          "git remote -v": "allow",
          "git push*": "ask"
        },
        "task": "allow"
      }
    },
    "knowledge-lead": {
      "description": "Context retrieval, reference library management, documentation generation, and skill creation",
      "mode": "primary",
      "model": "opencode/big-pickle",
      "permission": {
        "read": "allow",
        "edit": {
          "docs/opencode/**": "allow",
          ".opencode/skills/**": "allow",
          ".opencode/agents/**": "allow"
        },
        "bash": {
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git branch --show-current": "allow"
        },
        "task": "allow"
      }
    },
    "coordination-facilitator": {
      "description": "Facilitates cross-team coordination and communication",
      "mode": "subagent",
      "model": "9router/combo-cheap",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    },
    "meeting-scribe": {
      "description": "Records meeting notes, decisions, and action items",
      "mode": "subagent",
      "model": "9router/combo-cheap",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    },
    "decision-logger": {
      "description": "Logs and tracks team decisions and their rationale",
      "mode": "subagent",
      "model": "9router/combo-cheap",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    },
    "product-discovery": {
      "description": "Conducts product discovery and user research",
      "mode": "subagent",
      "model": "9router/combo-cheap",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    },
    "requirements-analyzer": {
      "description": "Analyzes and structures requirements from stakeholder input",
      "mode": "subagent",
