        },
        "task": "deny"
      }
    },
    "tdd-engineer": {
      "description": "Applies RED-GREEN-REFACTOR cycle for test-driven development",
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "edit": {
          "tests/**": "allow",
          "src/**": "allow"
        },
        "bash": {
          "npm test*": "allow",
          "node --test*": "allow"
        },
        "task": "deny"
      }
    },
    "integration-tester": {
      "description": "Designs and runs integration tests across component boundaries",
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "edit": {
          "tests/**": "allow"
        },
        "bash": {
          "npm test*": "allow",
          "node --test*": "allow"
        },
        "task": "deny"
      }
    },
    "testing-strategy-designer": {
      "description": "Designs testing strategies and selects appropriate test levels",
      "mode": "subagent",
      "model": "9router/combo-cheap",
      "permission": {
        "read": "allow",
        "edit": {
          "tests/**": "allow",
          "docs/**": "allow"
        },
        "bash": {
          "git status*": "allow",
          "git diff*": "allow"
        },
        "task": "deny"
      }
    },
    "code-reviewer": {
      "description": "Performs independent code review of implementation diffs",
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "bash": {
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow"
        },
        "task": "deny"
      }
    },
    "compliance-auditor": {
      "description": "Audits compliance with licenses, policies, and regulations",
      "mode": "subagent",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    },
    "ux-accessibility-reviewer": {
      "description": "Reviews user experience, accessibility (WCAG, ARIA), and interface consistency",
      "mode": "subagent",
      "model": "9router/combo-cheap",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      }
    },
    "ci-cd-infrastructure-engineer": {
      "description": "Designs CI/CD pipelines and manages infrastructure as code",
      "mode": "subagent",
      "model": "9router/combo-cheap",
      "permission": {
        "read": "allow",
        "edit": {
          ".github/**": "allow",
          "scripts/**": "allow",
          "Dockerfile*": "allow",
          "docker-compose*": "allow"
        },
        "bash": "allow",
        "task": "deny"
      }
    },
    "observability-designer": {
      "description": "Designs metrics, traces, logs, dashboards, alerts, and SLOs",
      "mode": "subagent",
      "model": "9router/combo-cheap",
      "permission": {
        "read": "allow",
        "edit": {
          ".github/**": "allow",
          "scripts/**": "allow",
          ".opencode/**": "allow"
        },
        "bash": {
          "git status*": "allow",
          "git diff*": "allow"
        },
        "task": "deny"
      }
    },
    "incident-triage-specialist": {
      "description": "Diagnoses, contains, and recovers from production incidents",
      "mode": "subagent",
      "model": "9router/combo-cheap",
      "permission": {
        "read": "allow",
        "edit": "deny",
        "bash": {
          "git status*": "allow",
          "git log*": "allow",
          "journalctl*": "ask",
          "systemctl*": "ask"
        },
        "task": "deny"
      }
    },
    "release-manager": {
      "description": "Manages releases, versioning, semantic versioning, and changelog",
      "mode": "subagent",
      "model": "9router/combo-cheap",
      "permission": {
        "read": "allow",
        "edit": {
          "CHANGELOG.md": "allow",
          "docs/**": "allow"
        },
        "bash": {
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git tag*": "ask",
          "npm version*": "ask",
          "npm pack*": "allow"
        },
        "task": "deny"
      }
