{
  "name": "@patrese/opencode-engineering-harness",
  "version": "0.1.0",
  "private": true,
  "description": "A versioned, auditable engineering harness and safe installer for OpenCode.",
  "type": "module",
  "bin": {
    "opencode-engineering-harness": "./bin/opencode-engineering-harness.js"
  },
  "files": [
    "bin",
    "src",
    "global",
    "templates"
  ],
  "scripts": {
    "test": "node --test tests/installer/installer.test.js",
    "test:installer": "node --test tests/installer/installer.test.js",
    "test:evals": "node --test tests/evals/runner.test.js",
    "eval:deterministic": "node evals/runner/run.js --layer deterministic",
    "eval:runtime": "node evals/runner/run.js --layer runtime",
    "eval:all": "node evals/runner/run.js --layer all"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
